<Project Sdk="Microsoft.NET.Sdk">
    <!--
        One project source packs all three tiers: dotnet pack -p:Tier=Vulkan|OpenGL|Software.
        The tier only ever changes what was compiled into the payload, so everything except the
        payload directory, the PackageId suffix and the published tier properties is identical.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <NoBuild>true</NoBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>

        <Tier Condition="'$(Tier)' == ''">Vulkan</Tier>
        <!--
            Each tier is a strict superset of the one below it, so no package can leave a hole in
            an Avalonia render-backend fallback chain. String.Equals is ordinal where MSBuild's own
            '==' is not, and the spelling ends up in a package id, so compare case-sensitively.
            On macOS the Vulkan tier is delivered by Metal: Vulkan only reaches Apple hardware
            through MoltenVK, which Skia does not vendor.
        -->
        <OptrisStaticGraphicsBackends Condition="$(Tier.Equals('Vulkan'))">Vulkan;OpenGL;Software</OptrisStaticGraphicsBackends>
        <OptrisStaticGraphicsBackends Condition="$(Tier.Equals('OpenGL'))">OpenGL;Software</OptrisStaticGraphicsBackends>
        <OptrisStaticGraphicsBackends Condition="$(Tier.Equals('Software'))">Software</OptrisStaticGraphicsBackends>
        <OptrisStaticGraphicsHasVulkan Condition="$(Tier.Equals('Vulkan'))">true</OptrisStaticGraphicsHasVulkan>
        <OptrisStaticGraphicsHasVulkan Condition="'$(OptrisStaticGraphicsHasVulkan)' == ''">false</OptrisStaticGraphicsHasVulkan>
        <!--
            ANGLE is Windows-only: the macOS ItemGroup in the consumer targets never references it
            and the Linux one does not DirectPInvoke av_libglesv2, so nothing would pull the
            archive in. It ships with every tier that claims OpenGL.
        -->
        <OptrisStaticGraphicsHasAngle Condition="$(Tier.Equals('Vulkan')) or $(Tier.Equals('OpenGL'))">true</OptrisStaticGraphicsHasAngle>
        <OptrisStaticGraphicsHasAngle Condition="'$(OptrisStaticGraphicsHasAngle)' == ''">false</OptrisStaticGraphicsHasAngle>
        <OptrisStaticGraphicsAngleBranch Condition="'$(OptrisStaticGraphicsAngleBranch)' == ''">7922</OptrisStaticGraphicsAngleBranch>
        <!-- A tier without ANGLE has no chromium branch to report, and claiming one would lie. -->
        <_OptrisStaticGraphicsPublishedAngleBranch Condition="'$(OptrisStaticGraphicsHasAngle)' == 'true'">$(OptrisStaticGraphicsAngleBranch)</_OptrisStaticGraphicsPublishedAngleBranch>

        <PackageId>Optris.StaticGraphics.Avalonia.$(Tier)</PackageId>
        <!--
            A release version, not a prerelease: upstream's 4.150.1-7922.1 forces every consumer
            and every consumer of a consumer to opt into prereleases forever. The ANGLE branch that
            used to sit in the prerelease label is published as a property instead.
        -->
        <SkiaSharpVersion Condition="'$(SkiaSharpVersion)' == ''">4.150.1</SkiaSharpVersion>
        <BuildRev Condition="'$(BuildRev)' == ''">1</BuildRev>
        <Version>$(SkiaSharpVersion).$(BuildRev)</Version>

        <Authors>Optris GmbH, original by greepar</Authors>
        <Company>Optris GmbH</Company>
        <Description Condition="$(Tier.Equals('Vulkan'))">Static SkiaSharp, HarfBuzzSharp and ANGLE libraries for Avalonia NativeAOT single-file publishing. Tier Vulkan: Vulkan (Metal on macOS), OpenGL/ANGLE and software rendering. ANGLE chromium branch $(OptrisStaticGraphicsAngleBranch).</Description>
        <Description Condition="$(Tier.Equals('OpenGL'))">Static SkiaSharp, HarfBuzzSharp and ANGLE libraries for Avalonia NativeAOT single-file publishing. Tier OpenGL: OpenGL/ANGLE and software rendering, no Vulkan. ANGLE chromium branch $(OptrisStaticGraphicsAngleBranch).</Description>
        <Description Condition="$(Tier.Equals('Software'))">Static SkiaSharp and HarfBuzzSharp libraries for Avalonia NativeAOT single-file publishing. Tier Software: software rendering only, no Vulkan and no OpenGL/ANGLE.</Description>
        <PackageTags>Avalonia;SkiaSharp;Vulkan;ANGLE;NativeAOT;Windows;Linux;macOS;Static</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Optris/Optris.StaticGraphics.Avalonia</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Optris/Optris.StaticGraphics.Avalonia</PackageProjectUrl>

        <_OptrisStaticGraphicsGeneratedDir>$(IntermediateOutputPath)generated/</_OptrisStaticGraphicsGeneratedDir>
        <_OptrisStaticGraphicsTierProps>$(_OptrisStaticGraphicsGeneratedDir)Optris.StaticGraphics.Avalonia.props</_OptrisStaticGraphicsTierProps>
        <_OptrisStaticGraphicsTierInfoSource>$(_OptrisStaticGraphicsGeneratedDir)Optris.StaticGraphics.Avalonia.TierInfo.cs</_OptrisStaticGraphicsTierInfoSource>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
        <None Include="lib/net8.0/_._" Pack="true" PackagePath="lib/net8.0/_._" />
        <!-- NuGet auto-imports buildTransitive/$(PackageId).props|.targets, and nothing else. -->
        <None Include="$(_OptrisStaticGraphicsTierProps)" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
        <None Include="buildTransitive/Optris.StaticGraphics.Avalonia.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
        <None Include="buildTransitive/Optris.StaticGraphics.Avalonia.RuntimeGuard.cs" Pack="true" PackagePath="buildTransitive/Optris.StaticGraphics.Avalonia.RuntimeGuard.cs" />
        <None Include="$(_OptrisStaticGraphicsTierInfoSource)" Pack="true" PackagePath="buildTransitive/Optris.StaticGraphics.Avalonia.TierInfo.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../External/NativeStatic/static-$(Tier)/win-x64/native/**/*" Pack="true" PackagePath="static/win-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/win-x86/native/**/*" Pack="true" PackagePath="static/win-x86/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/win-arm64/native/**/*" Pack="true" PackagePath="static/win-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/linux-x64/native/**/*" Pack="true" PackagePath="static/linux-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/linux-arm64/native/**/*" Pack="true" PackagePath="static/linux-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/linux-musl-x64/native/**/*" Pack="true" PackagePath="static/linux-musl-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/linux-musl-arm64/native/**/*" Pack="true" PackagePath="static/linux-musl-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/osx-x64/native/**/*" Pack="true" PackagePath="static/osx-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="../../External/NativeStatic/static-$(Tier)/osx-arm64/native/**/*" Pack="true" PackagePath="static/osx-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="OptrisStaticGraphicsValidateTier" BeforeTargets="_GetPackageFiles;GenerateNuspec;PrepareForBuild">
        <Error Condition="'$(OptrisStaticGraphicsBackends)' == ''"
               Text="Unknown tier '$(Tier)'. Expected one of: Vulkan, OpenGL, Software (case-sensitive)." />
    </Target>

    <!--
        The tier is fixed when the payload is compiled, so both files are generated once here
        rather than in every consumer build. They carry the same values into MSBuild and into C#,
        which keeps the build-time guard and the runtime guard from ever disagreeing. The props
        file is generated whole rather than imported into a hand-written one so that everything
        the package promises a consumer stands in the single file NuGet auto-imports.
        Hooked before _GetPackageFiles as well as GenerateNuspec because a target's dependencies
        run before its BeforeTargets, and _GetPackageFiles is one of GenerateNuspec's.
    -->
    <Target Name="OptrisStaticGraphicsGenerateTierFiles"
            DependsOnTargets="OptrisStaticGraphicsValidateTier"
            BeforeTargets="_GetPackageFiles;GenerateNuspec">
        <!--
            [MSBuild]::Escape turns the ';' in the backend list into %3B so the line stays one
            item instead of splitting into three; WriteLinesToFile writes the unescaped value.
            The same escape spells the ';' that ends a C# statement, %20 spells indentation that
            MSBuild would otherwise trim off the item, and %24 spells a '$' that has to reach the
            generated file instead of expanding here.
        -->
        <ItemGroup>
            <_OptrisStaticGraphicsTierPropsLine Include="&lt;Project&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20&lt;!-- Generated by $(PackageId) $(Version). Do not edit. --&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20&lt;PropertyGroup&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsRoot Condition=&quot;'%24(OptrisStaticGraphicsRoot)' == ''&quot;&gt;%24(MSBuildThisFileDirectory)../static/&lt;/OptrisStaticGraphicsRoot&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsTier&gt;$(Tier)&lt;/OptrisStaticGraphicsTier&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsBackends&gt;$([MSBuild]::Escape('$(OptrisStaticGraphicsBackends)'))&lt;/OptrisStaticGraphicsBackends&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsHasVulkan&gt;$(OptrisStaticGraphicsHasVulkan)&lt;/OptrisStaticGraphicsHasVulkan&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsHasAngle&gt;$(OptrisStaticGraphicsHasAngle)&lt;/OptrisStaticGraphicsHasAngle&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsAngleBranch&gt;$(_OptrisStaticGraphicsPublishedAngleBranch)&lt;/OptrisStaticGraphicsAngleBranch&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsPackageId&gt;$(PackageId)&lt;/OptrisStaticGraphicsPackageId&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsPackageVersion&gt;$(Version)&lt;/OptrisStaticGraphicsPackageVersion&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20&lt;/PropertyGroup&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20&lt;ItemGroup&gt;" />
            <!--
                Written as a literal instead of $(OptrisStaticGraphicsPackageId): MSBuild evaluates
                every property and import before any item, so by the time a second tier package's
                item is created the property already holds whichever package imported last, and the
                conflict would be reported against one name twice.
            -->
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20%20%20%20%20&lt;OptrisStaticGraphicsTierPackage Include=&quot;$(PackageId)&quot; /&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="%20%20%20%20&lt;/ItemGroup&gt;" />
            <_OptrisStaticGraphicsTierPropsLine Include="&lt;/Project&gt;" />

            <_OptrisStaticGraphicsTierInfoLine Include="// Generated by $(PackageId) $(Version). Do not edit." />
            <_OptrisStaticGraphicsTierInfoLine Include="namespace Optris.StaticGraphics%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="internal static class OptrisStaticGraphicsTierInfo" />
            <_OptrisStaticGraphicsTierInfoLine Include="{" />
            <_OptrisStaticGraphicsTierInfoLine Include="%20%20%20%20internal const string PackageId = &quot;$(PackageId)&quot;%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="%20%20%20%20internal const string Tier = &quot;$(Tier)&quot;%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="%20%20%20%20internal const string Backends = &quot;$([MSBuild]::Escape('$(OptrisStaticGraphicsBackends)'))&quot;%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="%20%20%20%20internal const bool HasVulkan = $(OptrisStaticGraphicsHasVulkan)%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="%20%20%20%20internal const bool HasAngle = $(OptrisStaticGraphicsHasAngle)%3B" />
            <_OptrisStaticGraphicsTierInfoLine Include="}" />
        </ItemGroup>
        <MakeDir Directories="$(_OptrisStaticGraphicsGeneratedDir)" />
        <WriteLinesToFile File="$(_OptrisStaticGraphicsTierProps)" Lines="@(_OptrisStaticGraphicsTierPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(_OptrisStaticGraphicsTierInfoSource)" Lines="@(_OptrisStaticGraphicsTierInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>
</Project>
